[
  {
    "label": "Run AppleScript",
    "command": "osascript",
    "args": ["$ZED_FILE"],
    "tags": ["applescript-script"]
  },
  {
    "label": "Compile to .scpt",
    "command": "bash",
    "args": [
      "-c",
      "OUT=\"${ZED_FILE%.*}.scpt\"; osacompile -o \"$OUT\" \"$ZED_FILE\" && echo \"Compiled → $OUT\""
    ],
    "tags": ["applescript-script"]
  },
  {
    "label": "Run handler $ZED_SYMBOL",
    "command": "bash",
    "args": [
      "-c",
      "set -e; B=$(mktemp -t zed-applescript-handler) && mv \"$B\" \"$B.applescript\" && T=\"$B.applescript\"; trap 'rm -f \"$T\"' EXIT; { cat \"$ZED_FILE\"; printf '\\n%s()\\n' \"$HANDLER\"; } > \"$T\"; osascript \"$T\""
    ],
    "env": {
      "HANDLER": "$ZED_SYMBOL"
    },
    "tags": ["applescript-handler"]
  }
]
